#!/bin/bash
# .rite/config - Project-specific Sharkrite configuration
# Place this file at $REPO_ROOT/.rite/config
# These settings override global config for this project only.

# =============================================================================
# Project Identity
# =============================================================================

# Override auto-detected project name (defaults to repo directory name)
# RITE_PROJECT_NAME="my-project"

# =============================================================================
# Worktree Location
# =============================================================================

# Override worktree directory for this project
# RITE_WORKTREE_DIR="$HOME/Dev/my-project-worktrees"

# =============================================================================
# Scratchpad Location
# =============================================================================

# Override scratchpad file path (defaults to .rite/scratch.md)
# SCRATCHPAD_FILE="$RITE_PROJECT_ROOT/.rite/scratch.md"

# =============================================================================
# AWS Integration
# =============================================================================

# AWS credential checks are auto-detected from repo dependencies and IaC markers.
# Override the detected profile if needed:
# AWS profile override for this project
# RITE_AWS_PROFILE="my-aws-profile"

# =============================================================================
# Notifications (opt-in)
# =============================================================================

# Enable notifications for this project (default: false)
# RITE_NOTIFICATIONS="true"

# Slack webhook URL (or set globally in ~/.config/rite/config)
# SLACK_WEBHOOK="https://hooks.slack.com/services/..."

# =============================================================================
# Provider Selection (per-phase, overrides global config)
# =============================================================================

# claude is the only shipped provider; these default to "claude". The per-phase
# vars exist so the codebase stays provider-neutral.
# RITE_DEV_PROVIDER="claude"
# RITE_REVIEW_PROVIDER="claude"
# RITE_UTILITY_PROVIDER="claude"

# =============================================================================
# Workflow Defaults
# =============================================================================

# Default workflow mode: supervised or unsupervised
# WORKFLOW_MODE="supervised"

# Target integration branch for PR base and merge operations (default: main).
# Override when the project uses a non-main integration branch (e.g. "develop").
# Consumed by the integration-branch workflow (cluster A issues #1033+).
# When set, worktrees fork from this branch and PRs target it as their base.
# RITE_TARGET_BRANCH="main"

# Maximum work-commits on a branch before rebase conflicts attempt LLM resolution
# instead of close-and-restart (default: 3).
# In auto mode, when a stale-branch rebase hits conflicts, branches with
# work-commit count <= this threshold restart fresh (exit 11) rather than invoking
# attempt_claude_merge_resolution — avoiding resolution + 181-file verification cost
# that routinely exceeds the original dev cost of small branches (issue #855).
# Set to 0 to disable the fast-path (always attempt LLM resolution).
# RITE_REBASE_CONFLICT_RESTART_MAX=3

# Absurd-divergence threshold for stale-branch auto mode (default: 100 commits).
# When a branch is MORE THAN this many commits behind its base (strict >), auto mode
# skips the rebase attempt and closes+restarts immediately. Prevents replaying truly
# enormous histories that signal an abandoned branch rather than normal main drift.
# Set to 0 to disable the guard (always attempt rebase regardless of distance).
# RITE_STALE_BRANCH_HARD_RESTART_THRESHOLD=100

# Assessment timeout for this project (complex projects may need longer)
# Default is 300s. Raise to 600 if assessments time out during heavy provider load.
# RITE_ASSESSMENT_TIMEOUT=300

# Follow-up issue dedup backoff (seconds between retry iterations; default: 5s)
# Under slow-GitHub conditions the lock holder can spend up to
# (RITE_GH_MAX_RETRIES * gh backoff) + (_dedup_max_retries * RITE_DEDUP_BACKOFF)
# seconds inside the lock.  The waiter times out after 60s.  Lowering this value
# reduces worst-case holder time.  See timing budget in lib/utils/issue-lock.sh.
# RITE_DEDUP_BACKOFF=5

# Per-finding follow-up issue cap (default: 20).
# Limits the number of GitHub issues created per assess run to prevent unbounded
# API usage on reviews with many findings.  Each finding triggers full dedup
# machinery (issue list + issue view + pr view + backoff sleeps), scaling N×.
# When the cap is reached, a [diag] FOLLOWUP_CAP_HIT line is emitted and a
# warning is printed with the count of skipped findings.
# Set to 0 to disable the cap entirely (unbounded — original behavior).
# RITE_MAX_FINDINGS_PER_RUN=20

# Live-lock defer wait (seconds; default: 30).
# When a dep issue holds a live lock in another concurrent batch session, the
# dependent issue is deferred to the end of the queue. A background sleep of
# this duration starts at defer time, allowing other queued issues to run
# concurrently. The deferred issue joins the sleep before re-checking the dep,
# so the foreign session has wall-clock time to merge. Set to 0 to disable the
# wait (issue still defers, but re-checking starts immediately after processing
# other queued issues — effective only when other issues provide enough buffer).
# RITE_LIVE_LOCK_DEFER_WAIT=30

# Maximum live-lock defer cycles per issue (default: 10).
# Decoupled from batch size so a 2-issue batch gets the same 10 × wait-secs
# budget as a large one. The queue-later defer path uses _UNIQUE_ISSUE_COUNT
# (frozen batch size) as its cap; the live-lock path uses this variable.
# Set to 0 to disable live-lock deferral entirely.
# RITE_LIVE_LOCK_MAX_DEFERS=10

# Batch gate circuit-breaker threshold (default: 3).
# When this many consecutive issues fail their post-commit gate with the same
# normalized failure signature (sorted unique failing-file set), the batch halts
# with exit 16 and a remediation hint.  This prevents a doomed environment
# (broken import, red main, bad test runner) from grinding through all remaining
# issues and minting unlimited follow-up issues.
# Set to 0 to disable the circuit breaker entirely.
# See: docs/architecture/exit-codes.md — exit 16
# RITE_BATCH_GATE_TRIP=3

# Unscoped suite warning threshold in seconds (default: 300).
# When a target repo's full test suite takes this long or longer on a fix cycle,
# the gate emits a once-per-gate-run warning recommending scoped selection (sharkrite #975
# / jest --findRelatedTests / vitest related / pytest --testmon).  Repeated
# occurrences in a week surface as a WARNING in the health report (≥3 in the
# period). Set to a larger value for projects with intentionally slow suites,
# or to 0 to silence the warning entirely (e.g. in a CI environment where the
# full-suite cost is already budgeted and expected).
# Only affects target repos (non-Sharkrite); Sharkrite's own targeted-selection
# runs are exempt by construction.
# RITE_GATE_SCOPE_WARN_SECONDS=300

# Minimum recurrence count before a review finding class is flagged as a lint-rule
# candidate in the weekly health report (default: 2).
# Titles appearing this many times or more across the period's ACTIONABLE_NOW findings
# are listed in the report's "Recurring findings — lint-rule candidates" sub-section.
# A separate category backstop (hardcoded at 4) catches reworded recurrences of the
# same class. Set to a higher value for high-volume projects where occasional repeats
# are expected noise.
# RITE_HEALTH_RECURRENCE_MIN=2

# Native diff scoping for node workspaces monorepo tests (default: true).
# When true, the per-cycle tier uses jest --findRelatedTests (or vitest related)
# to select only the test files that import/require the changed source files.
# When false, the per-cycle tier still restricts runs to changed workspace
# directories, but each affected workspace runs its full suite without
# framework-native file filtering. Set to false when the auto-detected
# framework-native scoping causes false passes (e.g. integration tests whose
# file is not reachable via the changed source's import graph).
# RITE_GATE_NATIVE_SCOPING=true

# Green-main preflight behavior when main is red (default: not set — halt).
# When unset or "0", a batch run halts with exit 20 if the full gate on
# origin/main finds failures. This guards gate block-on-any soundness:
# any failure in the targeted selection is this change's to fix — only valid
# when main is green.
#
# Set to "1" to proceed despite a red main. Sharkrite saves the failing
# tests/lint items as a baseline and subtracts them from each issue's
# assessment: failures also present on main become INFO_ONLY (not ACTIONABLE_NOW);
# branch-only failures remain ACTIONABLE_NOW.
#
# Intended for: repos where fixing main is blocked but branch work must continue.
# Live motivating case: LeadFlow 2026-07-05 (18 failing dashboard tests on main,
# 51 inherited ACTIONABLE_NOW items per issue, 30-minute wasted fix-loop).
# See: docs/architecture/behavioral-design.md → "Red-Main Degradation Contract"
# DORMANT as of 2026-10-13: the green-main preflight that produced the baseline
# was removed (full suites run only in the overnight pipeline, never in a
# workflow). The attribution-subtraction reader in assess-and-resolve.sh is
# still present and activates if a baseline JSON is supplied by other means.
# RITE_ACCEPT_RED_MAIN=0

# =============================================================================
# Plan Command (rite plan)
# =============================================================================

# Default architectural doc(s) for `rite plan` when no doc path is specified.
# Space-separated, relative to project root.
# RITE_PLAN_DOCS="docs/architecture/implementation-phases.md docs/roadmap.md"

# Maximum time estimate per issue before requiring decomposition (default: 2hr)
# RITE_PLAN_MAX_ESTIMATE="2hr"

# Auto-discovery byte cap for grounding docs injected into the plan prompt.
#
# `rite plan` automatically discovers and injects ADRs, README.md, and other
# docs/**/*.md files as authoritative grounding context. This prevents the
# planner from generating issues that conflict with documented constraints.
#
# Priority order within the cap:
#   1. ADRs (docs/**/*adr*.md, docs/ADR-*.md) — loaded in full, highest priority
#   2. README.md — loaded in full
#   3. Other docs/**/*.md — loaded alphabetically until cap is reached
#
# ADRs and README always load in full even if the cap is already exceeded.
# Other docs are skipped (with a logged warning) when the budget runs out.
#
# Default: 50000 (50KB). Raise for doc-heavy projects; lower for fast iteration.
# Set to 0 to disable auto-discovery entirely (explicit doc_paths still work).
# RITE_PLAN_DOC_BYTE_CAP=50000

# Whether to auto-inject the root README.md when running `rite plan`.
# Default: true (README is included as high-priority grounding context).
# Set to false or 0 to skip README injection — useful when the README is very
# large (e.g. a monorepo megadoc) or is not relevant to the planning session.
# ADRs and docs/**/*.md auto-discovery are unaffected by this toggle.
# RITE_PLAN_INCLUDE_README=true

# =============================================================================
# Unverified External Integration Detection (rite plan post-generation pass)
# =============================================================================

# Path to a custom additional fixture directory for grounding detection.
# Any hostname or package name that appears as a subdirectory under this path
# (or under the always-scanned "fixtures/" and "tests/fixtures/") is considered
# "grounded" and will not trigger a spike-issue prerequisite.
# Supply a single directory path; trailing /** or /* are stripped automatically.
# The walk is recursive (all subdirectory depths), so nested fixture layouts
# such as test/vcr_cassettes/prod/api.example.com/ are fully covered.
# Brace expansion is NOT supported.  Leave unset to use only the two default
# directories (fixtures/ and tests/fixtures/).
# Example: RITE_PLAN_FIXTURE_GLOB="test/vcr_cassettes/**"
# RITE_PLAN_FIXTURE_GLOB=""

# Set to "1" to skip the _detect_unverified_integrations pass entirely.
# Useful when the project has intentionally ungrounded integrations or the
# check is producing false positives for a specific planning run.
# Default: "0" (pass is active)
# RITE_PLAN_SKIP_INTEGRATION_CHECK=0

# =============================================================================
# Documentation
# =============================================================================

# Merges always update the conventions and tag-index catalogs. Doc drift
# tracking is opt-in (RITE_DOC_MODE below); nothing edits docs/ automatically.

# Docs map auto-rebuild (default: true).
# When true, docs_map_ensure() automatically rebuilds docs/docs-map.tsv
# when the file is missing. The map inventories README.md, CLAUDE.md, and
# docs/**/*.md with headings and ADR flags for use by cluster-B doc features.
# Set to "false" to suppress auto-rebuild (e.g. when the map is managed externally).
# RITE_DOCS_MAP_AUTO=true

# Model for the doc_update role (pending wiring to `rite docs` Tier-2 editing passes
# and align-docs reconcile — consumer wiring forthcoming in Tier 2 issues). A doc edit
# is read by a human as the product's description — quality justifies fable. Independent
# of RITE_DOC_ASSESSMENT_MODEL (tag dedup, structured comparison). Override to trade
# quality for speed when drafting or iterating quickly.
# RITE_DOC_UPDATE_MODEL="claude-fable-5"

# Doc drift consent (opt-in) — nothing edits docs/ automatically in any mode.
#
# Values:
#   "sync"      — each merge records a drift entry (docs it may have made
#                 inaccurate); `rite docs` proposes fixes for your approval.
#                 Set by rite --init / `rite docs` when you answer y.
#   "off"       — declined; nothing is recorded. Set when you answer n.
#   "changelog" — legacy: records drift entries; `rite docs` logs audit findings.
#
# LEAVE UNSET (default: empty) to be asked on the next supervised run or
# `rite docs`. Unset records nothing — unattended runs never opt a repo in.
# RITE_DOC_MODE="off"

# Doc proposal growth warning threshold (percent).
# In every doc-proposal preview, the computed byte delta is displayed.
# When an edit grows the doc by more than this percentage AND the proposal
# has no DESCRIPTION: line, the preview shows a visible flag prompting the
# operator to add one explaining the growth.
# The flag is informational only — the operator can still approve or skip.
# Default: 15 (flag edits that grow the doc by more than 15%).
# RITE_DOC_GROWTH_WARN_PCT=15
